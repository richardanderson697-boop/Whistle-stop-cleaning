# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Receiver of customer questionnaire estimate requests and booking notifications
ADMIN_EMAIL="admin@whistlestopcleaning.com"

# STRIPE_SECRET_KEY: Stripe secret key for live credit card payment processing (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# VITE_STRIPE_PUBLISHABLE_KEY: Stripe publishable key for client-side checkout (pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# SMS_NOTIFICATION_SIMULATOR: Built-in SMS & Email Dispatch status logger
SMS_ENABLED=true
